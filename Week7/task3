package college;

public class InvalidStudentDataException extends Exception {

    public InvalidStudentDataException(String message) {
        super(message);
    }
}



import college.InvalidStudentDataException;

public class Student {

    private String name;
    private int mark;

    public Student(String name) throws InvalidStudentDataException {

        if (name == null || name.trim().isEmpty()) {
            throw new InvalidStudentDataException("Name cannot be null or blank");
        }

    }
    public void setMark(int mark) throws InvalidStudentDataException {

        if (mark < 0 || mark > 100) {
            throw new InvalidStudentDataException(
                "Mark must be between 0 and 100"
            );
        }

        this.mark = mark;
    }

    public String toString() {
        return "Student Name: " + name + ", Mark: " + mark;
    }
}



import college.InvalidStudentDataException;

public class Week7Lab {

    public static void main(String[] args) {

        String[] marks = {"85", "abc", "120"};

        for (String text : marks) {

            try {

                int mark = Integer.parseInt(text);

                Student student = new Student("John Doe");
                student.setMark(mark);

            } catch (NumberFormatException e) {

                System.out.println(
                    "Invalid input: Mark must be a number."
                );

            } catch (InvalidStudentDataException e) {

                System.out.println(
                    "Invalid student data: " + e.getMessage()
                );

            } finally {

                System.out.println("Validation attempt complete");
                System.out.println();
            }
        }
    }
}

